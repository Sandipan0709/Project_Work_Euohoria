# Copy to .env and edit. Never commit .env.
FINTRACKR_DEBUG=1
# Required when FINTRACKR_DEBUG=0. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
FINTRACKR_SECRET_KEY=
FINTRACKR_ALLOWED_HOSTS=localhost,127.0.0.1
# FINTRACKR_CSRF_TRUSTED_ORIGINS=https://fintrackr.example.com
# FINTRACKR_DB_PATH=/var/lib/fintrackr/db.sqlite3
# Set to 0 only to test a non-debug build over plain http on localhost.
# FINTRACKR_HTTPS=0
# FINTRACKR_BEHIND_PROXY=1
